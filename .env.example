# Copy this file to .env and fill in your Supabase project's values
# (Supabase → Project Settings → API). See docs/CLOUD_SETUP.md.
#
# The anon key is meant to ship inside the app: row-level security in
# supabase/schema.sql is what keeps each customer's data private.
# Never put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
